# openpojo style. It matches the Eclipse default formatter (tabs) and the
# code.line.max.length=120 set by gjs-parent.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{xml,properties}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
